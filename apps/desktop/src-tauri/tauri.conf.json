{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dandi",
  "version": "0.1.0",
  "identifier": "com.itp-adieum.dandi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dandi",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "copyright": "Copyright © ITP-Adieum",
    "shortDescription": "Fast, cross-OS archiver that never breaks filenames.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["zip"],
        "name": "ZIP Archive",
        "description": "ZIP Archive",
        "mimeType": "application/zip",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["7z"],
        "name": "7-Zip Archive",
        "description": "7-Zip Archive",
        "mimeType": "application/x-7z-compressed",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["rar"],
        "name": "RAR Archive",
        "description": "RAR Archive",
        "mimeType": "application/vnd.rar",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["z01"],
        "name": "Split ZIP Volume",
        "description": "Split ZIP Volume",
        "mimeType": "application/zip",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["001"],
        "name": "Split Archive Volume",
        "description": "Split Archive Volume",
        "mimeType": "application/octet-stream",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["tar"],
        "name": "TAR Archive",
        "description": "TAR Archive",
        "mimeType": "application/x-tar",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["tgz"],
        "name": "Gzipped TAR Archive",
        "description": "Gzipped TAR Archive",
        "mimeType": "application/gzip",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["gz"],
        "name": "Gzip Archive",
        "description": "Gzip Archive",
        "mimeType": "application/gzip",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["zst", "tzst"],
        "name": "Zstandard Archive",
        "description": "Zstandard Archive",
        "mimeType": "application/zstd",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["bz2", "tbz2"],
        "name": "Bzip2 Archive",
        "description": "Bzip2 Archive",
        "mimeType": "application/x-bzip2",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["xz", "txz"],
        "name": "XZ Archive",
        "description": "XZ Archive",
        "mimeType": "application/x-xz",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
